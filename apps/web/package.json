{
  "name": "@otto/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "sh -c 'trap \"kill 0\" EXIT INT TERM; bun run dev:assets & bun run dev:server'",
    "dev:assets": "vite build --watch --mode development",
    "dev:server": "bun --watch src/server/index.tsx",
    "build": "bun run clean && bun run typecheck && bun run build:assets && bun run build:server",
    "build:assets": "vite build",
    "build:server": "bun build src/server/index.tsx --outdir dist/server --target bun",
    "start": "NODE_ENV=production bun dist/server/index.js",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@hono/node-server": "^1.19.6",
    "@otto/feature-billing": "workspace:*",
    "@otto/feature-platform": "workspace:*",
    "@otto/feature-user-profile": "workspace:*",
    "@otto/feature-workspace-chat": "workspace:*",
    "@otto/feature-workspace-core": "workspace:*",
    "@otto/feature-workspace-members": "workspace:*",
    "@otto/feature-workspace-slugs": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-router": "^1.139.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.10.5",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
