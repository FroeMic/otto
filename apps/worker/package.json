{
  "name": "@otto/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "bun --watch src/index.ts",
    "build": "bun run clean && bun run typecheck && bun run build:server",
    "build:server": "bun build src/index.ts --outdir dist --target bun",
    "start": "NODE_ENV=production bun dist/index.js",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workos-inc/node": "^8.9.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "postgres": "^3.4.7",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.0",
    "stripe": "^22.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^24.9.1",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
