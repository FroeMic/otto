{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@otto/auth": ["../packages/auth/src/index.ts"],
      "@otto/feature-runtime-core": [
        "../packages/features/runtime-core/src/index.ts"
      ],
      "@otto/feature-workspace-core": [
        "../packages/features/workspace-core/src/index.ts"
      ],
      "@otto/feature-workspace-slugs": [
        "../packages/features/workspace-slugs/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.mts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
