LANDING_PAGE_DOMAIN=localhost:3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/otto
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_HOST=/ingest
NEXT_PUBLIC_POSTHOG_TOKEN=
POSTHOG_PROXY_TARGET=https://eu.i.posthog.com
POSTHOG_ASSET_PROXY_TARGET=https://eu-assets.i.posthog.com

HETZNER_API_TOKEN=
HETZNER_API_BASE_URL=https://api.hetzner.cloud/v1
HETZNER_POLL_INTERVAL_MS=5000
HETZNER_ACTION_TIMEOUT_MS=300000
HETZNER_DEFAULT_LOCATION=ash
HETZNER_DEFAULT_SERVER_TYPE=cpx21
HETZNER_DEFAULT_IMAGE=ubuntu-24.04
HETZNER_SSH_KEY_NAMES=
INTEGRATION_GATEWAY_INTERNAL_URL=http://127.0.0.1:3001
INTEGRATION_GATEWAY_PORT=3001

RUNTIME_DEPLOY_PRIVATE_KEY=
RUNTIME_DEPLOY_PRIVATE_KEY_PATH=
RUNTIME_OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.4.15
# To enable Otto-managed runtime plugins, override with the Otto custom image:
# RUNTIME_OPENCLAW_IMAGE=ghcr.io/froemic/otto-openclaw:2026.4.15.2

RUNTIME_MODEL_PRIMARY=openai/gpt-5.4

CONTROL_PLANE_ENCRYPTION_SECRET=
CONTROL_PLANE_OPENAI_ADMIN_API_KEY=
CONTROL_PLANE_OAUTH_STATE_SECRET=
# Optional OpenAI proxy SSE diagnostic override. Set to 3 to confirm Bun
# idle-timeout failures; set to 0 to disable the per-request idle timeout.
OPENAI_PROXY_STREAM_IDLE_TIMEOUT_SECONDS=
# Stripe recurring monthly prices must use lookup keys:
# basic_monthly, plus_monthly, pro_monthly, max_monthly
# Stripe one-time top-up prices must use lookup keys:
# top_up_20, top_up_50, top_up_100, top_up_200
# Stripe webhook endpoint (local): http://localhost:3000/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RUNTIME_SSH_USERNAME=root
RUNTIME_SSH_PORT=22
RUNTIME_SSH_CONNECT_TIMEOUT_MS=5000
RUNTIME_SSH_COMMAND_TIMEOUT_MS=30000
RUNTIME_SSH_READY_TIMEOUT_MS=300000

WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=5
WORKER_STALE_JOB_TIMEOUT_MS=1800000
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_BASE_URL=http://localhost:3000
# Generate with: openssl rand -base64 24
# Must be at least 32 characters.
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Integrations
GANDI_API_TOKEN=
GANDI_BASE_URL=https://api.gandi.net/v5
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=
LINEAR_OAUTH_ACTOR=app
LINEAR_OAUTH_SCOPES=read,write,issues:create,comments:create,timeSchedule:write,app:mentionable,app:assignable,customer:read,customer:write,initiative:read,initiative:write
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/oauth/callback/integration/slack
SLACK_SIGNING_SECRET=
RUNTIME_BRAVE_API_KEY=
RUNTIME_SLACK_APP_TOKEN=
