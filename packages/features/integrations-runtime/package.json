{
  "name": "@otto/feature-integrations-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "exports": {
    ".": "./src/index.ts",
    "./db/client": "./src/db/client.ts",
    "./db/schema": "./src/db/schema.ts",
    "./integrations/framework": "./src/integrations/framework/index.ts",
    "./integrations/library/brave/settings-metadata": "./src/integrations/library/brave/settings-metadata.ts",
    "./integrations/library/slack/policy": "./src/integrations/library/slack/policy.ts",
    "./integrations/library/slack/settings-metadata": "./src/integrations/library/slack/settings-metadata.ts",
    "./integrations/library/slack/update-policy": "./src/integrations/library/slack/update-policy.ts",
    "./lib/crypto": "./src/lib/crypto.ts",
    "./lib/env": "./src/lib/env.ts",
    "./lib/slack-config": "./src/lib/slack-config.ts",
    "./lib/web-search-config": "./src/lib/web-search-config.ts",
    "./linear-client": "./src/linear-client.ts"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun run typecheck && bun run build:package",
    "build:package": "bun build src/index.ts --outdir dist --target bun",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
