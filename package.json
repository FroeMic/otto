{
  "name": "otto",
  "packageManager": "bun@1.3.5",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/features/*"
  ],
  "scripts": {
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node scripts/wait-for-db.mjs && drizzle-kit migrate --config=drizzle.config.ts",
    "dev": "bun run dev:web",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:frontend": "bun run dev:web",
    "dev:gateway": "bun run --cwd apps/gateway dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "worker": "bun run dev:worker",
    "dev:all": "sh -c 'trap \"kill 0\" EXIT INT TERM; bun run dev:api & bun run dev:gateway & bun run dev:worker & bun run dev:web'",
    "lint": "bun run lint:web",
    "lint:web": "bun run --cwd apps/web lint",
    "lint:frontend": "bun run lint:web",
    "lint:gateway": "bun run --cwd apps/gateway lint",
    "lint:api": "bun run --cwd apps/api lint",
    "lint:worker": "bun run --cwd apps/worker lint",
    "build": "bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "build:frontend": "bun run build:web",
    "build:gateway": "bun run --cwd apps/gateway build",
    "build:api": "bun run --cwd apps/api build",
    "build:worker": "bun run --cwd apps/worker build",
    "format:web": "bun run --cwd apps/web format",
    "format:frontend": "bun run format:web",
    "format:gateway": "bun run --cwd apps/gateway format",
    "format:api": "bun run --cwd apps/api format",
    "format:worker": "bun run --cwd apps/worker format",
    "format:workspace-chat": "bun run --cwd packages/features/workspace-chat format",
    "format:workspace-core": "bun run --cwd packages/features/workspace-core format",
    "format:workspace-onboarding": "bun run --cwd packages/features/workspace-onboarding format",
    "format:workspace-slugs": "bun run --cwd packages/features/workspace-slugs format",
    "test:web": "bun run --cwd apps/web test",
    "test:frontend": "bun run test:web",
    "test:gateway": "bun run --cwd apps/gateway test",
    "test:api": "bun run --cwd apps/api test",
    "test:worker": "bun run --cwd apps/worker test",
    "test:workspace-chat": "bun run --cwd packages/features/workspace-chat test",
    "test:workspace-core": "bun run --cwd packages/features/workspace-core test",
    "test:workspace-onboarding": "bun run --cwd packages/features/workspace-onboarding test",
    "test:workspace-slugs": "bun run --cwd packages/features/workspace-slugs test",
    "check:web": "bun run lint:web && bun run test:web && bun run build:web",
    "check:frontend": "bun run check:web",
    "check:gateway": "bun run lint:gateway && bun run test:gateway && bun run build:gateway",
    "check:api": "bun run lint:api && bun run test:api && bun run build:api",
    "check:worker": "bun run lint:worker && bun run test:worker && bun run build:worker",
    "lint:workspace-chat": "bun run --cwd packages/features/workspace-chat lint",
    "lint:workspace-core": "bun run --cwd packages/features/workspace-core lint",
    "lint:workspace-onboarding": "bun run --cwd packages/features/workspace-onboarding lint",
    "lint:workspace-slugs": "bun run --cwd packages/features/workspace-slugs lint",
    "build:workspace-chat": "bun run --cwd packages/features/workspace-chat build",
    "build:workspace-core": "bun run --cwd packages/features/workspace-core build",
    "build:workspace-onboarding": "bun run --cwd packages/features/workspace-onboarding build",
    "build:workspace-slugs": "bun run --cwd packages/features/workspace-slugs build",
    "check:workspace-chat": "bun run lint:workspace-chat && bun run test:workspace-chat && bun run build:workspace-chat",
    "check:workspace-onboarding": "bun run lint:workspace-onboarding && bun run test:workspace-onboarding && bun run build:workspace-onboarding",
    "check:workspace-slugs": "bun run lint:workspace-slugs && bun run test:workspace-slugs && bun run build:workspace-slugs",
    "check:workspace-core": "bun run lint:workspace-core && bun run test:workspace-core && bun run build:workspace-core",
    "runtime:image:publish": "./publish-runtime-image.sh"
  },
  "devDependencies": {
    "dotenv": "17.4.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.44.7",
    "postgres": "3.4.9"
  }
}
