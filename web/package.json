{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "sh -c 'trap \"kill 0\" EXIT INT TERM; npm run worker & npm run dev'",
    "build": "next build",
    "start": "next start",
    "worker": "bun src/worker/index.ts",
    "test:terminology": "node --import tsx --test src/lib/openclaw/managed-config.test.ts src/test/terminology-audit.test.ts",
    "test:openai-token": "node src/scripts/test-openai-token.mjs",
    "tenant:runtime": "bun src/scripts/tenant-runtime.ts",
    "tenant:runtime:apply": "bun src/scripts/tenant-runtime.ts apply",
    "tenant:runtime:refresh-image": "bun src/scripts/tenant-runtime.ts refresh-image",
    "verify:runtime-surface": "bun src/scripts/verify-runtime-surface.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/scripts/wait-for-db.mjs && drizzle-kit migrate",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@workos-inc/authkit-nextjs": "^2.16.1",
    "@workos-inc/node": "^8.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "next": "16.1.6",
    "postgres": "^3.4.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.6",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.5",
    "@types/three": "^0.183.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
